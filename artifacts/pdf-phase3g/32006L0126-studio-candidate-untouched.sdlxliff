12.</mrk> <mrk mtype="seg" mid="690">Restrictions</mrk></seg-source><target><mrk mtype="seg" mid="684"/> <mrk mtype="seg" mid="685"/> <mrk mtype="seg" mid="686"/> <mrk mtype="seg" mid="687"/> <mrk mtype="seg" mid="688"/> <mrk mtype="seg" mid="689"/> <mrk mtype="seg" mid="690"/></target><sdl:seg-defs><sdl:seg id="684"/><sdl:seg id="685"/><sdl:seg id="686"/><sdl:seg id="687"/><sdl:seg id="688"/><sdl:seg id="689"/><sdl:seg id="690"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="521"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="e8add0d8-b710-48e7-8bdf-945fdb284543"><source>(1) Note: a pictogram and a line for category AM will be added.</source><seg-source><mrk mtype="seg" mid="691">(1) Note:</mrk> <mrk mtype="seg" mid="692">a pictogram and a line for category AM will be added.</mrk></seg-source><target><mrk mtype="seg" mid="691"/> <mrk mtype="seg" mid="692"/></target><sdl:seg-defs><sdl:seg id="691"/><sdl:seg id="692"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="522"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="9afe4f4a-a04c-4c83-9524-6e7e7b05218e"><source>Note: the term ‘A2’ will be added to the section on motorcycle categories.</source><seg-source><mrk mtype="seg" mid="693">Note:</mrk> <mrk mtype="seg" mid="694">the term ‘A2’ will be added to the section on motorcycle categories.</mrk></seg-source><target><mrk mtype="seg" mid="693"/> <mrk mtype="seg" mid="694"/></target><sdl:seg-defs><sdl:seg id="693"/><sdl:seg id="694"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="523"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="f874ae3c-e5d7-443e-b775-a8d972e92509"><source><x id="18"/></source><seg-source><x id="18"/></seg-source><target><x id="18"/></target></trans-unit></group><group><sdl:cxts><sdl:cxt id="524"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="dec1019f-a637-44c5-95ae-527deaaa16a2"><source>30.12.2006</source><seg-source><mrk mtype="seg" mid="695">30.12.2006</mrk></seg-source><target><mrk mtype="seg" mid="695"/></target><sdl:seg-defs><sdl:seg id="695"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="525"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="022429fb-3172-438a-a077-66a3ccc8cae9"><source>Official Journal of the European Union</source><seg-source><mrk mtype="seg" mid="696">Official Journal of the European Union</mrk></seg-source><target><mrk mtype="seg" mid="696"/></target><sdl:seg-defs><sdl:seg id="696"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="526"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="a091a791-4666-49f3-9fb2-814e20dd5826"><source>L 403/37</source><seg-source><mrk mtype="seg" mid="697">L 403/37</mrk></seg-source><target><mrk mtype="seg" mid="697"/></target><sdl:seg-defs><sdl:seg id="697"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="527"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="48da63a9-c965-40e8-9416-2ff4621f7ece"><source>EN</source><seg-source><mrk mtype="seg" mid="698">EN</mrk></seg-source><target><mrk mtype="seg" mid="698"/></target><sdl:seg-defs><sdl:seg id="698"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="528"/><sdl:cxt id="6"/><sdl:node id="49"/></sdl:cxts><trans-unit id="1513e3dd-7544-4ed7-b2dd-84364f334b41"><source>SPECIMEN MODEL LICENCE</source><seg-source><mrk mtype="seg" mid="699">SPECIMEN MODEL LICENCE</mrk></seg-source><target><mrk mtype="seg" mid="699"/></target><sdl:seg-defs><sdl:seg id="699"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="529"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="249e55be-05eb-4cc6-90f8-67c6cbe12db7"><source>BELGIAN LICENCE (for information)</source><seg-source><mrk mtype="seg" mid="700">BELGIAN LICENCE (for information)</mrk></seg-source><target><mrk mtype="seg" mid="700"/></target><sdl:seg-defs><sdl:seg id="700"/></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="530"/><sdl:cxt id="2"/></sdl:cxts><trans-unit id="1f808a10-cf7b-41cb-9e04-9ae7341387bd"><source><x id="19"/></source><seg-source>