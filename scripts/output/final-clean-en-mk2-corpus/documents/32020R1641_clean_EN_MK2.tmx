      <prop type="x-Context">-4596473658971105615, -1116162874385632779</prop>
      <prop type="x-ContextContent">I, the undersigned official inspector, hereby certify that: |  | Јас, долупотпишаниот службен инспектор, потврдувам дека: | </prop>
