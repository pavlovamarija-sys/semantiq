    <tu creationdate="20211010T145822Z" creationid="DESKTOP-77DJ777\Katerina" changedate="20211010T150128Z" changeid="DESKTOP-77DJ777\Katerina" lastusagedate="20211010T150128Z">
      <prop type="x-Context">-26982933861872196, -4226081748423771012</prop>
      <prop type="x-Origin">TM</prop>
      <prop type="x-ConfirmationLevel">Translated</prop>
      <tuv xml:lang="en-GB">
        <seg>(8)	The Risk Assessment Report on BZP reveals a lack of conclusive scientific evidence on the overall risks of BZP.</seg>
      </tuv>
      <tuv xml:lang="mk-MK">
        <seg>(8)Извештајот за процена на ризик од БЗП открива недостаток од цврсти научни докази за целокупните ризици од БЗП.</seg>
      </tuv>
      <prop type="x-CELEX">32008D0206</prop>
      <prop type="x-SourceTUIndex">24</prop>
      <prop type="x-MK2Provenance">final dry run accepted clean HIGH</prop>
