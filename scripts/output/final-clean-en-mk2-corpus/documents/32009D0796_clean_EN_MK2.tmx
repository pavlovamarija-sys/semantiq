      <tuv xml:lang="en-GB">
        <seg>
          <bpt i="1" type="pt16" />Having regard to the initiative of the Kingdom of the <ept i="1" />
          <bpt i="2" type="pt17" />Netherlands (<ph x="1" type="ph18" />),<ept i="2" />
        </seg>
      </tuv>
      <tuv xml:lang="mk-MK">
        <seg>имајќи ја предвид инцијативата на Кралството на Холандија (),</seg>
      </tuv>
