      <prop type="x-ConfirmationLevel">Translated</prop>
      <tuv xml:lang="en-GB">
        <seg>‘Article 2</seg>
      </tuv>
      <tuv xml:lang="mk-MK">
        <seg>„Член 2</seg>
      </tuv>
      <prop type="x-CELEX">32009D0796</prop>
      <prop type="x-SourceTUIndex">22</prop>
      <prop type="x-MK2Provenance">final dry run accepted clean HIGH</prop>
