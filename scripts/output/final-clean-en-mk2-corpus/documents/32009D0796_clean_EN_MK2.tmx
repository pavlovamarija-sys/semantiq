      <tuv xml:lang="en-GB">
        <seg>Decision 2002/956/JHA is hereby amended as follows:</seg>
      </tuv>
      <tuv xml:lang="mk-MK">
        <seg>та 2002/956/ПВР се изменува како што следува:</seg>
      </tuv>
      <prop type="x-CELEX">32009D0796</prop>
      <prop type="x-SourceTUIndex">19</prop>
      <prop type="x-MK2Provenance">final dry run accepted clean HIGH</prop>
